#!/usr/bin/env python3
"""Render captured Paper dialog components with the canonical RusCrafting renderer."""
import argparse
from pathlib import Path
import subprocess
import sys
import yaml

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--ops-root', type=Path, default=Path.home() / 'mcserver')
parser.add_argument('--client-jar', type=Path)
parser.add_argument('--output', type=Path, default=root / 'build/reports/dialog-preview')
args = parser.parse_args()
manifest = yaml.safe_load((root / 'visual-preview.yml').read_text())
manifest['sources'] = {}
manifest['surfaces'] = {'dialogs': []}
# Deduplicate repeat visits while preserving distinct loading/disabled/selected states.
seen = set()
for path in sorted((root / 'build/dialog-snapshots').glob('*.yml')):
    serialized = path.read_text()
    if serialized in seen:
        continue
    seen.add(serialized)
    screen = yaml.safe_load(serialized)
    source = 'screen_' + path.stem.replace('.', '_').replace('-', '_')
    manifest['sources'][source] = {
        'path': str(path.relative_to(root)),
        'include': ['name', 'external_title', 'body.*.text', 'buttons.*.text', 'buttons.*.tooltip'],
    }
    manifest['surfaces']['dialogs'].append({
        'id': path.stem, 'source': source, 'format': 'reference-multi-action',
        'name-key': 'name', 'external-title-key': 'external_title', 'columns': screen['columns'],
        'body': [{'id': key, 'text-key': f'body.{key}.text', 'width': value['width']}
                 for key, value in screen['body'].items()],
        'buttons': [{'id': key, 'text-key': f'buttons.{key}.text',
                     'tooltip-key': f'buttons.{key}.tooltip', 'width': value['width']}
                    for key, value in screen['buttons'].items()],
        'variants': [{'id': 'default'}], 'viewport': [640, 360],
    })
if not seen:
    parser.error('No dialog snapshots: run ./gradlew clean test first')
generated = root / 'build/dialog-preview-manifest.yml'
generated.write_text(yaml.safe_dump(manifest, allow_unicode=True, sort_keys=False))
command = [sys.executable, '-B', str(args.ops_root / '.agents/skills/design-ruscrafting-surfaces/scripts/render_plugin_surface_dump.py'),
           '--manifest', str(generated), '--project-root', str(root), '--output', str(args.output)]
if args.client_jar:
    command += ['--client-jar', str(args.client_jar)]
raise SystemExit(subprocess.run(command).returncode)
